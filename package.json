{
  "name": "forever-meta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Тир-лист спеков World of Warcraft по реальным логам Warcraft Logs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/spa-fallback.ts",
