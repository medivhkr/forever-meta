{
  "name": "forever-meta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Тир-лист спеков World of Warcraft по реальным логам Warcraft Logs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/spa-fallback.ts",
    "preview": "vite preview",
    "collect": "node scripts/collect.ts",
    "demo-data": "node scripts/collect.ts --demo",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "icons": "node scripts/make-icons.ts",
    "items": "node scripts/build-items.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^31.0.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
